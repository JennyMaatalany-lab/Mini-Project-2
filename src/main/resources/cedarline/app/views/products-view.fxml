<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cedarline.app.controllers.ProductsController">
   <top>
      <VBox spacing="3.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <Label text="Inventory Department - Products">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Track stock levels, suppliers and storage locations" />
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="330.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="22.0" />
         </padding>
         <children>
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="92.0" prefWidth="92.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="170.0" />
               </columnConstraints>
               <children>
                  <Label text="Product" GridPane.rowIndex="0" />
                  <TextField fx:id="nameFld" promptText="Product name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Category" GridPane.rowIndex="1" />
                  <TextField fx:id="categoryFld" promptText="e.g. Pantry" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Supplier" GridPane.rowIndex="2" />
                  <TextField fx:id="supplierFld" promptText="Supplier name" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="In stock" GridPane.rowIndex="3" />
                  <TextField fx:id="quantityFld" promptText="Units in stock" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Unit price ($)" GridPane.rowIndex="4" />
                  <TextField fx:id="unitPriceFld" promptText="e.g. 12.75" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Reorder at" GridPane.rowIndex="5" />
                  <TextField fx:id="reorderLevelFld" promptText="Alert below this stock" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label text="Location" GridPane.rowIndex="6" />
                  <TextField fx:id="locationFld" promptText="e.g. Warehouse A / Shelf 3" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addProduct" text="Insert" />
                  <Button mnemonicParsing="false" onAction="#updateProduct" text="Update" />
                  <Button mnemonicParsing="false" onAction="#deleteProduct" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
               </children>
            </HBox>
            <Label fx:id="messageLbl" wrapText="true" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="productsTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="idCol" prefWidth="75" text="SKU" />
            <TableColumn fx:id="nameCol" prefWidth="150" text="Product" />
            <TableColumn fx:id="categoryCol" prefWidth="90" text="Category" />
            <TableColumn fx:id="supplierCol" prefWidth="110" text="Supplier" />
            <TableColumn fx:id="quantityCol" prefWidth="60" text="Stock" />
            <TableColumn fx:id="unitPriceCol" prefWidth="80" text="Price ($)" />
            <TableColumn fx:id="reorderLevelCol" prefWidth="70" text="Reorder" />
            <TableColumn fx:id="locationCol" prefWidth="100" text="Location" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="No products yet." />
         </placeholder>
         <BorderPane.margin>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
