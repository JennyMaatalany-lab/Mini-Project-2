<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cedarline.app.controllers.EmployeesController">
   <top>
      <VBox spacing="3.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <Label text="HR Department - Employees">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Maintain employee records, contact details and complaints" />
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="330.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="22.0" />
         </padding>
         <children>
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="92.0" prefWidth="92.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="170.0" />
               </columnConstraints>
               <children>
                  <Label text="First name" GridPane.rowIndex="0" />
                  <TextField fx:id="firstNameFld" promptText="Employee's first name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Last name" GridPane.rowIndex="1" />
                  <TextField fx:id="lastNameFld" promptText="Employee's last name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Address" GridPane.rowIndex="2" />
                  <TextField fx:id="addressFld" promptText="Street, building" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Email" GridPane.rowIndex="3" />
                  <TextField fx:id="emailFld" promptText="name@company.example" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Phone" GridPane.rowIndex="4" />
                  <TextField fx:id="phoneFld" promptText="+961 3 123 456" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Department" GridPane.rowIndex="5" />
                  <ComboBox fx:id="departmentBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label text="Complaint" GridPane.rowIndex="6" />
                  <TextField fx:id="complaintFld" promptText="Leave empty if none" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addEmployee" text="Insert" />
                  <Button mnemonicParsing="false" onAction="#updateEmployee" text="Update" />
                  <Button mnemonicParsing="false" onAction="#deleteEmployee" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
               </children>
            </HBox>
            <Label fx:id="messageLbl" wrapText="true" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="employeesTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="idCol" prefWidth="75" text="ID" />
            <TableColumn fx:id="firstNameCol" prefWidth="90" text="First name" />
            <TableColumn fx:id="lastNameCol" prefWidth="90" text="Last name" />
            <TableColumn fx:id="addressCol" prefWidth="120" text="Address" />
            <TableColumn fx:id="emailCol" prefWidth="150" text="Email" />
            <TableColumn fx:id="phoneCol" prefWidth="100" text="Phone" />
            <TableColumn fx:id="departmentCol" prefWidth="90" text="Department" />
            <TableColumn fx:id="complaintCol" prefWidth="140" text="Complaint" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="No employees yet." />
         </placeholder>
         <BorderPane.margin>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
