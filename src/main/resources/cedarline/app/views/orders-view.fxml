<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cedarline.app.controllers.OrdersController">
   <top>
      <VBox spacing="3.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <Label text="Orders Department - Orders">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Record customer orders, delivery destinations and status" />
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="330.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="22.0" />
         </padding>
         <children>
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="92.0" prefWidth="92.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="170.0" />
               </columnConstraints>
               <children>
                  <Label text="Client" GridPane.rowIndex="0" />
                  <TextField fx:id="clientNameFld" promptText="Client name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Product" GridPane.rowIndex="1" />
                  <TextField fx:id="productNameFld" promptText="Product name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Quantity" GridPane.rowIndex="2" />
                  <TextField fx:id="quantityFld" promptText="Units ordered" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Price ($)" GridPane.rowIndex="3" />
                  <TextField fx:id="priceFld" promptText="e.g. 385.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Destination" GridPane.rowIndex="4" />
                  <TextField fx:id="destinationFld" promptText="Delivery address / city" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Order date" GridPane.rowIndex="5" />
                  <TextField fx:id="orderDateFld" promptText="yyyy-mm-dd" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label text="Status" GridPane.rowIndex="6" />
                  <ComboBox fx:id="statusBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addOrder" text="Insert" />
                  <Button mnemonicParsing="false" onAction="#updateOrder" text="Update" />
                  <Button mnemonicParsing="false" onAction="#deleteOrder" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
               </children>
            </HBox>
            <Label fx:id="messageLbl" wrapText="true" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="ordersTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="idCol" prefWidth="75" text="Order" />
            <TableColumn fx:id="clientNameCol" prefWidth="120" text="Client" />
            <TableColumn fx:id="productNameCol" prefWidth="140" text="Product" />
            <TableColumn fx:id="quantityCol" prefWidth="50" text="Qty" />
            <TableColumn fx:id="priceCol" prefWidth="80" text="Price ($)" />
            <TableColumn fx:id="destinationCol" prefWidth="130" text="Destination" />
            <TableColumn fx:id="orderDateCol" prefWidth="90" text="Date" />
            <TableColumn fx:id="statusCol" prefWidth="80" text="Status" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="No orders yet." />
         </placeholder>
         <BorderPane.margin>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
