<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cedarline.app.controllers.ClientsController">
   <top>
      <VBox spacing="3.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <Label text="Clients Department - Clients">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Keep client contact details and business types up to date" />
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="330.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="22.0" />
         </padding>
         <children>
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="92.0" prefWidth="92.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="170.0" />
               </columnConstraints>
               <children>
                  <Label text="Company" GridPane.rowIndex="0" />
                  <TextField fx:id="nameFld" promptText="Client / company name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Contact" GridPane.rowIndex="1" />
                  <TextField fx:id="contactPersonFld" promptText="Person we talk to" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Phone" GridPane.rowIndex="2" />
                  <TextField fx:id="phoneFld" promptText="+961 9 123 456" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Email" GridPane.rowIndex="3" />
                  <TextField fx:id="emailFld" promptText="name@client.example" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Address" GridPane.rowIndex="4" />
                  <TextField fx:id="addressFld" promptText="Street, building" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="City" GridPane.rowIndex="5" />
                  <TextField fx:id="cityFld" promptText="e.g. Jounieh" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label text="Type" GridPane.rowIndex="6" />
                  <ComboBox fx:id="clientTypeBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addClient" text="Insert" />
                  <Button mnemonicParsing="false" onAction="#updateClient" text="Update" />
                  <Button mnemonicParsing="false" onAction="#deleteClient" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#clearForm" text="Clear" />
               </children>
            </HBox>
            <Label fx:id="messageLbl" wrapText="true" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="clientsTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="idCol" prefWidth="75" text="ID" />
            <TableColumn fx:id="nameCol" prefWidth="120" text="Company" />
            <TableColumn fx:id="contactPersonCol" prefWidth="100" text="Contact" />
            <TableColumn fx:id="phoneCol" prefWidth="100" text="Phone" />
            <TableColumn fx:id="emailCol" prefWidth="150" text="Email" />
            <TableColumn fx:id="addressCol" prefWidth="120" text="Address" />
            <TableColumn fx:id="cityCol" prefWidth="80" text="City" />
            <TableColumn fx:id="clientTypeCol" prefWidth="100" text="Type" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="No clients yet." />
         </placeholder>
         <BorderPane.margin>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
